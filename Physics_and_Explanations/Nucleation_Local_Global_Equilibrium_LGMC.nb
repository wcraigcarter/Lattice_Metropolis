     "   ", 
     RowBox[{
      RowBox[{"config", " ", "=", 
       RowBox[{"origConfig", "=", " ", 
        RowBox[{"ArrayPad", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "35"}], ")"}], "^", "2"}], " ", "+", " ", 
                
                RowBox[{"j", "^", "2"}]}], " ", "<=", " ", "50"}], ",", "1", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
