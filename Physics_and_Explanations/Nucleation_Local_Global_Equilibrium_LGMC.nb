Cell[CellGroupData[{

Cell["\<\
Global and Local Equilibrium:
Nucleation and Hysteresis in the Lattice Gas Metropolis Model\
\>", "Chapter",
 CellChangeTimes->{{3.993983422593746*^9, 3.993983468202016*^9}, {
  3.993992533700328*^9, 
  3.993992551956036*^9}},ExpressionUUID->"fd59601e-d2fe-4865-8a27-\
8571170e7e43"],

Cell[TextData[{
 "Each value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]\[Mu]", "\[LongEqual]", 
         SubscriptBox["\[Mu]", 
          StyleBox["O", "TI"]], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta \\mu = \\mu_{O} - \\mu_{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6523b767-d754-4eac-9c73-e87215fc0586"],
 " has an equilibrium concentration. "
}], "Text",
 CellChangeTimes->{{3.993983488276864*^9, 3.993983502221859*^9}, {
  3.9939835396324577`*^9, 3.99398374904388*^9}, {3.993983814809626*^9, 
  3.993983815541995*^9}, {3.993983865700156*^9, 
  3.993983866136443*^9}},ExpressionUUID->"c1ff8d67-8474-4118-bba9-\
417ab58525cd"],

Cell[TextData[{
 "We probe the concentrations by iteratively finding the concentration as we \
sweep along values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb42800e-785b-4235-bcb0-f9c8a29f2610"],
 ". \n\nIn this case, we will probe the behavior for the case where there are \
two disordered phases separated by a miscibility gap.  This is the classic \
case of a phase diagram associated with spinodal decomposition.\n",
