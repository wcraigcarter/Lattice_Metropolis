            RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
             RowBox[{"OptionValue", "[", "\"\<energyNearest\>\"", "]"}]}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
