     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{"latticeGasBulkExchangeSweep", ",", "sweepBranchWithNuclei"}], 
       "}"}], "]"}]}], "]"}], " ", ":=", " ", "\[IndentingNewLine]", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"config", ",", "origConfig", ",", " ", 
