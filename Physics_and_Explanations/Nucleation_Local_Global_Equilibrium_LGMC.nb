}], "Text",
 CellChangeTimes->{{3.9939838726394787`*^9, 3.993984082110264*^9}, {
  3.9939876783731728`*^9, 3.9939876786900387`*^9}, {3.993987713960081*^9, 
  3.993987714539583*^9}},ExpressionUUID->"0742b653-5c34-45b9-a0c9-\
83ad61fee231"],

Cell["\<\
However, because the appearance of a new phase comes with a surface energy \
penalty, it is possible that the equilibrium phase will not appear (i.e., if \
there is a nucleation barrier.

This notebook explores this behavior.\
\>", "Text",
 CellChangeTimes->{{3.993983948646899*^9, 3.993983961425914*^9}, {
  3.9939877320154867`*^9, 
  3.993987794133053*^9}},ExpressionUUID->"8db217dd-7eb8-4951-b706-\
c45faa1a5224"],

Cell[CellGroupData[{

Cell[TextData[{
 "Concentration versus ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4e87935-29b4-4524-b516-549efbd2ea63"],
 " starting from an uniform random configuration"
}], "Subsection",
 CellChangeTimes->{{3.9939880084385242`*^9, 
  3.9939880579663258`*^9}},ExpressionUUID->"53cb4655-3397-4d59-8483-\
6e39773995fb"],

Cell[TextData[{
 "The function ",
 StyleBox["sweepBranch",
  FontVariations->{"Underline"->True}],
 " takes a list of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "de69b9c4-2a5f-4537-9bf0-02655e79cb82"],
 "\[CloseCurlyQuote]s  iterates at each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5343873b-7f95-46af-a927-7c7c84e6881a"],
 " enough iterations to have confidence the system has reached a (local) \
equilibrium.  \n\nAfter each equilibrium is found, the system uses the last \
configuration for the previous ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3be4db46-7e69-4faf-a1db-063843c6e215"],
 " as a starting point\[LongDash]akin to doing a slow experimental sweep with \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a1b9003-29d4-422f-9ec3-ba94d9ff5af5"],
 ".\n\nThe function returns an  of final concentrations and final \
configurations.\n\nFor example:"
}], "Text",
 CellChangeTimes->{{3.993988070398686*^9, 3.9939881467589083`*^9}, {
  3.993988809757535*^9, 
  3.993989073749979*^9}},ExpressionUUID->"84521f2a-7ad3-4d5a-a35d-\
eab9d210ba36"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"concetrations", ",", " ", "configurations"}], "}"}], "=", 
   RowBox[{"sweepBranch", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.2", ",", "0.9"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "1.0"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "0.4"}]}], ",", "\n", 
     RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "1.2"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9939891033085318`*^9, 3.9939891072366657`*^9}, {
   3.9939891528464317`*^9, 3.993989228593157*^9}, 3.993989296521543*^9},
 CellLabel->
  "In[389]:=",ExpressionUUID->"6ccb1b20-d6f1-4cde-ad6d-fde059b4580e"],

Cell[BoxData["concetrations"], "Input",
 CellChangeTimes->{{3.9939892326148443`*^9, 3.9939892441725893`*^9}, 
   3.993989298312595*^9},ExpressionUUID->"80a4806a-ff97-4e83-af7f-\
bc2b520c1552"],

Cell[BoxData[
 RowBox[{"drawLattice", "[", 
  RowBox[{
   RowBox[{"configurations", "[", "0.2", "]"}], ",", 
   RowBox[{"ImageSize", "->", "400"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.993989248264771*^9, 3.9939892857091722`*^9}},
 CellLabel->
  "In[388]:=",ExpressionUUID->"fbf05d1f-1c6f-4c7a-a44d-295d2f951c12"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.993989595778639*^9, 
  3.993989600074679*^9}},ExpressionUUID->"8f9f9354-a171-4d1e-b678-\
36ea213c0b34"],

Cell[TextData[{
 "We will sweep over these values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2f2e630-6190-490c-b552-c146bd14be0e"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989769783197*^9, 
  3.993989793731168*^9}},ExpressionUUID->"a871eea4-8da2-4185-8cd3-\
013e167ba759"],

Cell[BoxData["deltaMuValues"], "Input",
 CellLabel->
  "In[426]:=",ExpressionUUID->"ab27dfc6-1edc-4901-94a2-7f61e4ea4e88"],

Cell[TextData[{
 "First, we start from the negative values and increment to towards positive ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd93d1a4-f0a5-4d01-ba6b-1ce2424ce783"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989660732513*^9, 3.9939896658731337`*^9}, {
  3.993989740522737*^9, 3.9939897474098*^9}, {3.993989796368186*^9, 
  3.9939898307783318`*^9}},ExpressionUUID->"1965c042-0c08-457c-9f51-\
266c736f233f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"upBranch", ",", " ", "upConfigurations"}], "}"}], " ", "=", " ", 
   
   RowBox[{"sweepBranch", "[", 
    RowBox[{"deltaMuValues", ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "1.0"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "0.4"}]}], ",", "\n", 
     RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "1.2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99398963711419*^9, 3.9939896453865137`*^9}},
 CellLabel->
  "In[427]:=",ExpressionUUID->"2cb3bfe1-b2ea-412d-8ef3-850e7215f813"],

Cell[TextData[{
 "Next, we start from the positive values and increment to towards negative \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c012718f-6340-4e40-9722-c61110585563"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989660732513*^9, 3.9939896658731337`*^9}, {
   3.993989740522737*^9, 3.9939897474098*^9}, {3.993989796368186*^9, 
   3.9939898658550377`*^9}, 
   3.993992111996358*^9},ExpressionUUID->"ede8bfbd-d5d1-46d6-a655-\
6bb7d704639c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"downBranch", ",", " ", "downConfigurations"}], "}"}], "=", " ", 
